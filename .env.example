# PostgreSQL — TablePlus ile birebir aynı alanlar (URL kullanılmaz)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=postgres
DB_SSL=false
# Mac Postgres.app: şifre yokken Next.js otomatik /tmp soketini kullanır (DB_SOCKET=/tmp ile zorlanabilir)
# Vercel: managed Postgres host + DB_SSL=true

# Site URL (SEO canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://blacknook.com
NEXT_PUBLIC_APP_URL=https://blacknook.com

# Partner görselleri (Docker'da /app/uploads + volume)
UPLOAD_DIR=uploads

# İlk kurulum admin (yoksa oluşturulur; varsa şifreye dokunulmaz)
ADMIN_EMAIL=admin@blacknook.com
ADMIN_PASSWORD=BlacknookAdmin1
ADMIN_NAME=Admin

# NextAuth — Vercel'de ZORUNLU (Settings → Environment Variables)
# openssl rand -base64 32
NEXTAUTH_SECRET=
# Production site URL (Vercel'de kendi domain'iniz)
NEXTAUTH_URL=https://your-app.vercel.app

# OAuth (opsiyonel — Google).
# Kod anahtarı: src/lib/googleOAuth.ts → ENABLE_GOOGLE_OAUTH=true
# + GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (UI için isteğe bağlı NEXT_PUBLIC_GOOGLE_OAUTH=1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_OAUTH=

# Spline (opsiyonel, public URL)
NEXT_PUBLIC_SPLINE_URL=https://prod.spline.design/YOUR_SCENE_ID/scene.splinecode

# Coder v2 — Geliştirici Portal → Kendi uygulamanı yap (şimdilik kapalı)
# Açmak için: NEXT_PUBLIC_CODER_FEATURE_ENABLED=true ve app’i yeniden build edin
NEXT_PUBLIC_CODER_FEATURE_ENABLED=false
# UI: http://127.0.0.1:7080  |  compose servisleri: coder + coder-db
CODER_ACCESS_URL=http://127.0.0.1:7080
CODER_URL=http://coder:7080
NEXT_PUBLIC_CODER_URL=http://127.0.0.1:7080
# İlk admin sonrası: Account → Tokens + templates push blacknook-dev
CODER_API_TOKEN=
CODER_TEMPLATE_ID=
CODER_PG_USER=coder
CODER_PG_PASSWORD=coderpass
CODER_PG_DB=coder

# --- E-posta (en basit: Gmail App Password) ---
# 1) Google Hesabı → Güvenlik → 2 Adımlı Doğrulama AÇIK
# 2) Uygulama şifreleri → Mail → 16 haneli şifre üret
# 3) Aşağıya yapıştır (normal Gmail şifresi ÇALIŞMAZ)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# Gmail’de FROM, SMTP_USER ile aynı hesap olmalı
SMTP_FROM="Blacknook <your@gmail.com>"

# Destek asistanı — geçici demo modu (örnek yanıtlar, API çağrısı yok)
# Gerçek LLM için: SUPPORT_DEMO_MODE=false ve OPENAI_API_KEY doldurun
SUPPORT_DEMO_MODE=true
OPENAI_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-4o-mini

# Ekip bildirimleri (kurulum / waitlist)
INSTALLATION_REQUEST_TO=dev@blacknook.com
# Destek talepleri (eski: eşleşme)
MATCH_REQUEST_TO=contact@blacknook.com

# Aider CLI (yerel kod asistanı)
ANTHROPIC_API_KEY=
